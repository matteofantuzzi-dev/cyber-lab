# File per rendere lo script un servizio di sistema che giri in backgorund

[Unit]
Description=Monitor Risorse Raspberry Pi (Temp, CPU, RAM)
After=network.target

[Service]
ExecStart=/usr/bin/python3 -u /home/pirasp/cyberlab-monitor/monitor.py
WorkingDirectory=/home/pirasp/cyberlab-monitor
StandardOutput=inherit
StandardError=inherit
Restart=always
User=pirasp

[Install]
WantedBy=multi-user.target
